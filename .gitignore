# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# local runtime persistence
.alter0/*
!.alter0/agents/
!.alter0/skills/
.alter0/agents/*
!.alter0/agents/*/
.alter0/agents/*/*
!.alter0/agents/*/SKILL.md
.alter0/skills/*
!.alter0/skills/*/
.alter0/skills/*/*
!.alter0/skills/*/SKILL.md
!.alter0/skills/*/scripts/
.alter0/skills/*/scripts/*
!.alter0/skills/*/scripts/*.sh

# temporary outputs, test artifacts, debug files
output/
test-results/
.playwright-cli/
node_modules/

# local deploy/runtime artifacts
bin/
scripts/*.bak-*
*.tmp
*.temp
*.swp
*.swo

# Editor/IDE
# .idea/
# .vscode/
